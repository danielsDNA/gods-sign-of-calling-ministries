# Application
VITE_APP_NAME=v8 App Template
VITE_PUBLIC_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# Server
NODE_ENV=development
PORT=3000

# Features
VITE_ENABLE_SOURCE_MAPPING=true
VITE_ENABLE_SSR=true
# Optional public Google Analytics measurement ID (analytics loads only after consent)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Development Tools
VITE_SHOW_DEV_TOOLS=false
# Optional: same as app id — local Docker preview sets SITE_ID; with vite envPrefix SITE_, client can link to /develop/{id}
# SITE_ID=

# Supabase PostgreSQL (use the Supabase connection pooler URI for Vercel)
SUPABASE_DB_URL=
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=


# External APIs (when needed)
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here

# GoDaddy Commerce (when skill-installed)
# Set by commerce-related skills when storefront features are added
# VITE_GODADDY_CLIENT_ID=<uuid-from-task-config>
# VITE_GODADDY_API_HOST=<hostname-from-GODADDY_API_BASE_URL>
# GODADDY_API_BASE_URL=https://api.dev-godaddy.com

# Authentication (when needed)
# JWT_SECRET=your-secret-here
# SESSION_SECRET=your-secret-here
# Admin session signing secret (generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))")
ADMIN_SESSION_SECRET=

# Password reset email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Church Website <no-reply@example.org>
